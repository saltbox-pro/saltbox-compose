---
{% macro make_list(var, name) %}
{%- set val = env.get(var) %}
{%- set lst = val.strip(' ,').split(',') if val else [] %}
{%- if lst %}
{{- name }}:
{%- for i in lst %}
  - '{{- i | trim }}'
{%- endfor %}
{%- endif %}
{%- endmacro %}

names:
  saltbox:
    country_name: RU
    state_or_province_name: Central Federal District
    locality_name: Moscow
    organization_name: Salt.Box
    common_name: saltbox
  redis-salt:
    country_name: RU
    state_or_province_name: Central Federal District
    locality_name: Moscow
    organization_name: Salt.Box
    common_name: redis-salt
  proxy:
    country_name: RU
    state_or_province_name: Central Federal District
    locality_name: Moscow
    organization_name: Salt.Box
    common_name: localhost

certs:
  /mnt/redis_certs/ca.crt:
    subject: saltbox
    not_valid_after_days: null
    key_password: '{{ env['CA_KEY_PASSWORD'] }}'
    basic_constraints:
      ca: true
      path_length: 0  # No further CA certificates
    issue:
      /mnt/redis_certs/redis.crt:
        subject: redis-salt
        not_valid_after_days: null
        key_password: '{{ env['REDIS_KEY_PASSWORD'] }}'
        basic_constraints:
          ca: false
          path_length: null
        alternative_names_ip:
          - '127.0.0.1'
        alternative_names_dns:
          - localhost
          - redis-salt
        extended_key_usage:
          server: true
          client: false
      {{ env['PROXY_CERT'] }}:
        subject: proxy
        not_valid_after_days: null
        key_password: null
        basic_constraints:
          ca: false
          path_length: null
        {{ make_list('SSL_ALT_NAMES_IP', 'alternative_names_ip') | indent(8) }}
        {{ make_list('SSL_ALT_NAMES_DNS', 'alternative_names_dns') | indent(8) }}
        extended_key_usage:
          server: true
          client: false
