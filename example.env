# shellcheck disable=SC2034

################################################################################
## File is a part of FastMS project.
##
## Move to .env before editing.
##
## BUILD TIME comment means changing the value requireds rebuilding of some
## images.
##
################################################################################

################################################################################
## General settings
################################################################################

## Additional gorups of services.
## Exclude salt-master profile if rely on an external salt-master.
COMPOSE_PROFILES=salt-master

## Docker registry options to fetch images.
IMAGE_REGISTRY='registry.altlab.su/fastms'  # BUILD TIME
CORE_IMAGE_TAG=master
FRONTEND_IMAGE_TAG=master


## Docker Compose graceful shutdown period
STOP_GRACE_PERIOD=5s

################################################################################
## Reverse proxy settings
################################################################################

## This section definces on which URL the system should be available, e.g.
## http://locahost:80 by default.

## On which host web UI available
WEB_SERVER_HOST=localhost
## Port to server interface for enduser
WEB_SERVER_PORT=80
## 'http' allowed only for localhost, 'https' for encrypted HTTP
WEB_SERVER_SCHEME=http
## ws | wss for encrypted websockets
WEB_SERVER_WS_SCHEME=ws

## Usually not an object to change
WEB_SERVER_SOCKET="${WEB_SERVER_HOST}:${WEB_SERVER_PORT}"
WEB_SERVER_BASE_URL="${WEB_SERVER_SCHEME}://${WEB_SERVER_SOCKET}"

################################################################################
## Keycloak SSO settings
################################################################################

KEYCLOAK_BASE_URL='/auth/keycloak'  # BUILD TIME  # FIXME
KEYCLOAK_DATABASE='keycloak'
KEYCLOAK_DATABASE_USER='keycloak-db'
KEYCLOAK_REALM='fastms'
KEYCLOAK_CLIENT='fastms_core'
# 'false' may be required to work on real domain through proxy
KEYCLOAK_STRICT_HTTPS='true'

## Default FastMS user. Will be created with the $KEYCLOAK_REALM on first run.
KEYCLOAK_USER_NAME='user'  # No user if empty
## If following variables is empty, form will need to be filled on first logon.
KEYCLOAK_USER_EMAIL='user@example.com'
KEYCLOAK_USER_FIRSTNAME='Ioann'
KEYCLOAK_USER_LASTNAME='Ivanov'

################################################################################
## Backend (Core) settings
################################################################################

# On which host backend answers
BACKEND_HOST="$WEB_SERVER_HOST"
BACKEND_HTTP_PORT=8000
BACKEND_PATH='/api/core'

## Graceful shutdown timeout for Uvicorn
BACKEND_SHUTDOWN_TIMEOUT_SEC=5

REDIS_SALT_USERNAME=redis
REDIS_CELERY_USERNAME=redis

################################################################################
## Frontend settings
################################################################################

FRONTEND_HTTP_PORT=80
FRONTEND_OPEN_ID_REDIRECT_URL="${WEB_SERVER_SCHEME}://${WEB_SERVER_HOST}"

################################################################################
## SaltStack settings
################################################################################

SALT_API_USER='fastms_core'
SALT_MASTER_LOG_LEVEL='warning'
SALT_API_LOG_LEVEL='info'

################################################################################
## MongoDB settings
################################################################################

MONGO_DB='fastms'
MONGO_USER='root'

################################################################################
## Dev options
################################################################################

## Default compose file with no dev options.
COMPOSE_FILE=compose.yaml
## Uncomment for fastms-core, redis-salt watch and rebuild, mongo port epxpose.
#COMPOSE_FILE="${COMPOSE_FILE}:compose-backend-dev.yaml"
## Uncomment to enable frontend rebuild from sources.
#COMPOSE_FILE="${COMPOSE_FILE}:compose-frontend-dev.yaml"
## Uncomment to rebuild SaltStack rebuild, dev settings and dev minions.
#COMPOSE_FILE="${COMPOSE_FILE}:compose-salt-dev.yaml"

SALT_MINION_REPLICAS=4
CORE_BUILD_DIR=../fastms-core/
FRONTEND_BUILD_DIR=../fastms-frontend/
