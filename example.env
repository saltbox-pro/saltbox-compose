# shellcheck disable=SC2034

################################################################################
## File is a part of Salt.Box project.
##
## Move to .env before editing.
##
## BUILD TIME comment means changing the value requireds rebuilding of some
## images.
##
## Env-file supports variable expansion like VAR2='${VAR1}/something', therefore
## it is not recommended since may cause inconsistent values when some exanded
## variables overrided.
##
################################################################################

################################################################################
## General settings
################################################################################

COMPOSE_PROJECT_NAME=saltbox

## Additional gorups of services.
## Exclude salt-master profile if rely on an external salt-master.
COMPOSE_PROFILES=salt-master

## Docker registry options to fetch images.
IMAGE_REGISTRY='registry.saltbox.pro/saltbox'

## Tags of Salt.Box images.
## Usually should all point the same minor version (first two digits of version
## string).
CORE_AUTOTESTS_TAG='v0.1.0'
GATEWAY_IMAGE_TAG='v0.1.0'
CORE_IMAGE_TAG='v0.1.0'
FRONTEND_IMAGE_TAG='v0.1.0'
KEYCLOAK_IMAGE_TAG='v0.1.0'
MAKE_CERTS_IMAGE_TAG='v0.1.0'
NGINX_IMAGE_TAG='v0.1.0'
OPA_IMAGE_TAG='v0.1.0'
REDIS_IMAGE_TAG='v0.1.0'
SALT_MASTER_IMAGE_TAG='v0.1.0'
SSHFS_IMAGE_TAG='v0.1.0'

## Docker Compose graceful shutdown period
STOP_GRACE_PERIOD=5s

################################################################################
## Reverse proxy settings
################################################################################

## This section definces on which URL the system should be available, e.g.
## https://localhost:443 by default.

## Port to server interface for enduser
WEB_SERVER_PORT=443
# [ HOST | HOST:PORT ], PORT may differ when outer reverse proxy is used.
WEB_SERVER_OUTER_SOCKET='localhost'
# Certificate will be created for the following DNS names (separated by commas)
WEB_SERVER_SSL_ALT_NAMES_DNS='localhost,saltbox.local'
# Certificate will be created for the following IP addresses (separated by commas)
WEB_SERVER_SSL_ALT_NAMES_IP='127.0.0.1'

# Nginx workers, 1 is a reasonable value for under 100 Salt.Box users.
WEB_SERVER_WORKER_PROCESSES=1
# Nginx workers CPU cores fine binding.
WEB_SERVER_WORKER_CPU_AFFINITY='auto'

################################################################################
## Keycloak SSO settings
################################################################################

KEYCLOAK_BASE_URL='/auth/keycloak'  # Use compose-keycloak-buid.yaml override to apply
KEYCLOAK_DATABASE='keycloak'
KEYCLOAK_DATABASE_USER='keycloak-db'
KEYCLOAK_REALM='salt.box'
KEYCLOAK_CLIENT='saltbox_core'
KEYCLOAK_CLIENT_GRAFANA='grafana'

## KEYCLOAK_{ADMIN,USER}_* variables has been DEPRECATED

## Default salt.box user. Will be created with the $KEYCLOAK_REALM on first run.
SALTBOX_USER_USERNAME='user'  # No user if empty
## If following variables is empty, form will need to be filled on first logon.
SALTBOX_USER_EMAIL='user@example.com'
SALTBOX_USER_FIRSTNAME='Ioann'
SALTBOX_USER_LASTNAME='Ivanov'

## Default salt.box admin user. Will be created with the $KEYCLOAK_REALM on first run.
SALTBOX_ADMIN_USERNAME='master'  # No admin user if empty
## If following variables is empty, form will need to be filled on first logon.
SALTBOX_ADMIN_EMAIL='master@example.com'
SALTBOX_ADMIN_FIRSTNAME='Petr'
SALTBOX_ADMIN_LASTNAME='Petrov'

################################################################################
## Backend (Core) settings
################################################################################

# On which host backend answers
BACKEND_HTTP_PORT=8000
BACKEND_PATH='/api/core'

# For more verbose backend log set to 'debug'
SALTBOX_CORE_LOG_LEVEL='info'

## Graceful shutdown timeout for Uvicorn
BACKEND_SHUTDOWN_TIMEOUT_SEC=5

REDIS_SALT_USERNAME=redis
REDIS_TASKIQ_USERNAME=redis
## Set to '6379' or '0.0.0.0:6379' to expose on all interfaces
REDIS_SALT_EXPOSE_SOCKET='127.0.0.1:6379'

SALT_FUNC_REPO_URL='https://dev.saltbox.pro/saltbox/salt-func-schemas.git'
GITLAB_BASE_URL='https://dev.saltbox.pro'
GITLAB_TOKEN=''  # No token by default, only public repos access.
GITLAB_GROUP_ID=76  # Salt.Box Configuration.Boxes group ID

# Core Discovery settings
CORE_SERVICE_NAME='core'
CORE_SERVICE_TITLE='SaltBox Core Service'
CORE_SERVICE_DESCRIPTION='Core service of SaltBox project.'
CORE_SERVICE_VENDOR='Salt.Box'
CORE_SERVICE_TYPE='official'
CORE_INSTANCE_ID='77535eb39ce94e638b7fd454aa18c9b5'
CORE_HOST='saltbox-core'
CORE_PORT=8000
CORE_FRONT_CONTAINER_NAME='saltbox-frontend-core'
CORE_FRONT_CONTAINER_PORT=80

################################################################################
## Frontend settings
################################################################################

FRONTEND_HTTP_PORT=80

################################################################################
## SaltStack settings
################################################################################

SALT_MASTER_STORAGE_PATH='./_salt-master-storage/'
SALT_MASTER_LOG_LEVEL='warning'
SALT_MINION_LOG_LEVEL='warning'
SALTBOX_BRIDGE_LOG_LEVEL='info'

################################################################################
## MongoDB settings
################################################################################

MONGO_DB='salt_box'
MONGO_USER='root'
## Set to '27017' or '0.0.0.0:27017' to expose on all interfaces
MONGO_EXPOSE_SOCKET='127.0.0.1:27017'

################################################################################
## SSHFS settings
################################################################################

## SSH username as in ssfs._users.json
SSHFS_USER=saltbox
## Where to keep files of clients like backups.
SSHFS_STORAGE_PATH='./_sshfs-storage/'
## [ PORT | IP_ADDRESS | IP_ADDRESS:PORT ] Socket to bind SSH daemon.
SSHFS_EXPOSE_SOCKET='1022'


################################################################################
## Gateway settings
################################################################################
GATEWAY_PATH='/api/core'
GATEWAY_SHUTDOWN_TIMEOUT_SEC=5
GATEWAY_HTTP_PORT=8001
GATEWAY_WORKERS=4
GATEWAY_LOG_LEVEL='info'

################################################################################
## Dev options
################################################################################

## Default compose file with no dev options.
COMPOSE_FILE=compose.yaml

## Uncomment to be able to run autotests.
#COMPOSE_FILE="${COMPOSE_FILE}:compose-autotests.yaml"
## Uncomment for saltbox-core, redis-salt watch and rebuild, mongo port epxpose.
#COMPOSE_FILE="${COMPOSE_FILE}:compose-backend-dev.yaml"
## Uncomment to enable frontend rebuild from sources.
#COMPOSE_FILE="${COMPOSE_FILE}:compose-frontend-dev.yaml"
## Uncomment to build Keycloak images locally
#COMPOSE_FILE="${COMPOSE_FILE}:compose-keycloak-build.yaml"
## Uncomment to rebuild SaltStack rebuild, dev settings and dev minions.
#COMPOSE_FILE="${COMPOSE_FILE}:compose-salt-dev.yaml"
## Uncomment to run mock minions.
#COMPOSE_FILE="${COMPOSE_FILE}:compose-mock-minions.yaml"
## Uncomment to enable metrics.
#COMPOSE_FILE="${COMPOSE_FILE}:compose-metrics.yaml"

SALT_MOCK_MINION_REPLICAS=4
SALT_MOCK_MINION_LOG_LEVEL='warning'
SALT_MOCK_MINION_RETRY_DNS=10
CORE_BUILD_DIR='../saltbox-core/'
FRONTEND_BUILD_DIR='../saltbox-frontend/'
SALT_BUILD_DIR='../saltbox-bridge/'
BRIDGE_MESSAGES_DIR='../saltbox-bridge-messages/'
SDK_DIR='../saltbox-sdk/'
GATEWAY_BUILD_DIR='../saltbox-gateway/'
