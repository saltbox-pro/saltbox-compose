server {
    listen 80;
    server_name localhost;

    location / {
        proxy_pass http://fastms-frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /env.json {
        alias /srv/html/env.json;
        add_header Content-Type application/json;
        add_header Access-Control-Allow-Origin *;
    }

    location '${KEYCLOAK_BASE_URL}/' {
        proxy_pass 'http://keycloak:8080';
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${WEB_SERVER_SCHEME};
        proxy_set_header X-Forwarded-Host $host;
    }
    
    location ${BACKEND_PATH}/ {
        proxy_pass 'http://${BACKEND_HOSTNAME}:${BACKEND_HTTP_PORT}';
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        rewrite ^${BACKEND_PATH}/(.*)$ /$1 break;
    }
}

