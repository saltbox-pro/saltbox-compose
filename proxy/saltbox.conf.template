map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

upstream gateway {
    zone saltbox 64k;
    server saltbox-gateway:${GATEWAY_HTTP_PORT} resolve;
}

upstream front-root-config {
    zone saltbox;
    server saltbox-frontend-root-config resolve;
}

upstream front-base {
    zone saltbox;
    server saltbox-frontend-base resolve;
}

upstream front-gateway {
    zone saltbox;
    server saltbox-frontend-gateway resolve;
}

upstream kc {
    zone saltbox;
    server keycloak:8080 resolve;
}

server {
    listen 443 ssl default_server;
    http2 on;

    ssl_certificate /etc/nginx/ssl/proxy.crt;
    ssl_certificate_key /etc/nginx/ssl/proxy.key;
    client_max_body_size 10g;
    client_body_timeout 10m;

    location / {
        proxy_pass http://front-root-config;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /api {
        rewrite ^ $request_uri;
        rewrite ^(/.*) $1 break;
        return 400;
        proxy_pass 'http://gateway$1';
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    location /api/filebrowser/api/raw {
        # Fix for quirky Cache-Control header
        # TODO (a.karmanov): Delete after rewriting FM backend
        rewrite ^ $request_uri;
        rewrite ^(/.*) $1 break;
        return 400;
        proxy_pass 'http://gateway$1';
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_hide_header Cache-Control;
        add_header Cache-Control 'no-cache';
    }

    location /static {
        rewrite ^ $request_uri;
        rewrite ^(/.*) $1 break;
        return 400;
        proxy_pass 'http://gateway$1';
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    location /static/base {
        proxy_pass http://front-base;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        rewrite '^/static/base/(.*)$' '/$1' break;
    }

    location /static/gateway {
        proxy_pass http://front-gateway;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        rewrite '^/static/gateway/(.*)$' '/$1' break;
    }

    location '${KEYCLOAK_BASE_URL}/' {
        proxy_buffers 8 256k;
        proxy_buffer_size 128k;
        proxy_busy_buffers_size 256k;
        proxy_pass http://kc;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
    }

    include '${SALTBOX_INCLUDES_DIR}/*.conf';
}

server {
    listen 80 default_server;
    return 301 https://$host$request_uri;
}

