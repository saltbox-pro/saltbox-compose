# shellcheck disable=SC2034
#
# File is a part of FastMS project.
#
# BUILD TIME comment means changing the value requireds rebuilding of some
# images.

# Common settings
#
# Port to server interface for enduser
GLOBAL_PUBLIC_PORT=80
# Docker Compose graceful shutdown period
STOP_GRACE_PERIOD=5s

# Keycloak SSO settings
KEYCLOAK_BASE_URL='/auth/keycloak'  # BUILD TIME
KEYCLOAK_DATABASE='keycloak'
KEYCLOAK_DATABASE_USER='keycloak-db'
KEYCLOAK_REALM='fastms'
KEYCLOAK_CLIENT='fastms_core'

# Backend (Core) settings
BACKEND_HOST='localhost'
BACKEND_HTTP_PORT=8000
BACKEND_BASE_URL='/api/core'
# Graceful shutdown timeout for Uvicorn
BACKEND_SHUTDOWN_TIMEOUT_SEC=5

# Frontend settings
FRONTEND_HTTP_PORT=80
FRONTEND_OPEN_ID_REDIRECT_URL="http://${BACKEND_HOST}"

# SaltStack settings
SALT_API_USER='fastms_core'  # BUILD TIME
SALT_MASTER_LOG_LEVEL='warning'
SALT_API_LOG_LEVEL='info'

# MongoDB settings
MONGO_DB='fastms'
MONGO_USER='root'

# Dev options
SALT_MINION_REPLICAS=4
