# shellcheck disable=SC2034

# Common settings
#
# Port to server interface for enduser
GLOBAL_PUBLIC_PORT=80

# Keycloak SSO settings
KEYCLOAK_BASE_URL='/auth/keycloak'
KEYCLOAK_DATABASE='keycloak'
KEYCLOAK_DATABASE_USER='keycloak-db'

# Backend (Core) settings
BACKEND_HTTP_PORT=8000
BACKEND_BASE_URL='/api/core'
BACKEND_SHUTDOWN_TIMEOUT_SEC=5

# Frontend settings
FRONTEND_HTTP_PORT=80
FRONTEND_SERVER_NAME='localhost'

# SaltStack settings
SALT_API_USER='fastms_core'
SALT_MASTER_LOG_LEVEL='warning'
SALT_API_LOG_LEVEL='info'

# Dev options
SALT_MINION_REPLICAS=4
