# shellcheck disable=SC2034

#Keycloak
KEYCLOAK_ADMIN='admin'
KEYCLOAK_ADMIN_PASSWORD='password'
KEYCLOACK_HOST='127.0.0.1'
KEYKOACK_BASE_URL='/auth/keycloak'

# Backend settings
BACKEND_HTTP_PORT=8000
BACKEND_BASE_URL='/api/core'

# Frontend settings
FRONTEND_HTTP_PORT=80
SERVER_NAME='localhost'
SERVER_PORT=${BACKEND_HTTP_PORT}

# Dev options
MINION_REPLICAS=4

# SaltStack settings
SALT_MASTER_LOG_LEVEL='warning'
SALT_API_LOG_LEVEL='info'
